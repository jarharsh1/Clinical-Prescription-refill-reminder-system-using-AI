# Secret used to sign JWT access tokens. Generate your own for real deployments,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=change-me-to-a-random-secret

# SQLAlchemy database URL. Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./refill_reminder.db

# Optional: enables AI-generated reminder message text via the Claude API.
# Leave unset to fall back to deterministic template messages (the app works
# fully without this key; only the wording of reminder messages changes).
ANTHROPIC_API_KEY=

# Access token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=480
